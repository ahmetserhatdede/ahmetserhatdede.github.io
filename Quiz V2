/*Programming Requirements
1. Read the complete record as a String.
2. Use String class methods, including substring(), to extract information from the record.
3. Use Integer.parseInt() to convert the six numeric substrings to int values.
4. Use arithmetic expressions to calculate the total.
5. Use an explicit type conversion (casting) so that the average is calculated using decimal division.
6. Do not use if statements, loops, arrays, or ArrayList. */


import java.util.Scanner;
public class MyProgram
{
    
    public static void main(String[] args)
    {
        Scanner input = new Scanner(System.in);
        
        System.out.println("Enter the filament record: ");
        String record = input.nextLine();
        
        // PLA - 420 - 275 - 610 - 350 - 495 - 251
        // 012 3 456 7 89* 1 234 5 678 9 ?12 3 456
        
        int num1 = Integer.parseInt(record.substring(4,7));
        int num2 = Integer.parseInt(record.substring(8,11));
        int num3 = Integer.parseInt(record.substring(12,15));
        int num4 = Integer.parseInt(record.substring(16,19));
        int num5 = Integer.parseInt(record.substring(20,23));
        int num6 = Integer.parseInt(record.substring(24));
        
        String code = record.substring(0,3);
        
        
        int total = num1 + num2 + num3 + num4 + num5 + num6;
        
        double avr = (double) total / 6; 
        
        /*
Material: PLA
Total filament: 2401 grams
Average per spool: 400.1666666666667 grams*/ 
        
        System.out.print(" Material: " + code + "\n" 
        + "Total filament: " + total + "grams\n"
        + "Average per spool: " + avr + "grams");
        
// Sedat hoca derste soru kolay dediğinde haklı olduğunu fark etiim. "Yalan" dediğim için özür dilemem lazım.
// parseInt kullanımını öğrenmiş oldum. Bu methodu college boarddaki sorulara benzer sorularda kullanmak lazım.
        
    }
}



