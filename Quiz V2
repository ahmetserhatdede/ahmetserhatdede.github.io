        System.out.print("Write the instructions: ");
        String list = input.nextLine();
        
        //H02 B04 A02 W02 T01
        //012 345 678 9*1 234
        
        String BS1 = list.substring(0,1);
        String BS2 = list.substring(3,4);
        String BS3 = list.substring(6,7);
        String BS4 = list.substring(9,10);
        String BS5 = list.substring(12,13);
        
        String SS1 = list.substring(1,3);
        String SS2 = list.substring(4,6);
        String SS3 = list.substring(7,9);
        String SS4 = list.substring(10,12);
        String SS5 = list.substring(13);
        
        String P1 = list.substring(0,3);
        String P2 = list.substring(3,6);
        String P3 = list.substring(6,9);
        String P4 = list.substring(9,12);
        String P5 = list.substring(12);
        
        int S1 = Integer.parseInt(list.substring(1,3));
        int S2 = Integer.parseInt(list.substring(4,6));
        int S3 = Integer.parseInt(list.substring(7,9));
